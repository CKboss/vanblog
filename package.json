      "min-document": "^2.19.1",

      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "braces@3": "^3.0.3",
      "picomatch@2": "^2.3.2",
      "minimatch@3": "^3.1.4",
      "minimatch@8": "^8.0.6",
      "micromatch@4": "^4.0.8",
      "cross-spawn@6": "^6.0.6",
      "cross-spawn@7": "^7.0.5",
