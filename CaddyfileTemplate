{
  on_demand_tls {
    ask http://127.0.0.1:3000/api/admin/caddy/ask
  }
  admin 0.0.0.0:2019
  email VAN_BLOG_EMAIL
	log {
		output file /var/log/caddy.log
	}

}
(h) {
  trusted_proxies private_ranges
}


(van) {
  # 安全响应头（零风险的那几项）。
  # 不加 CSP：前台/后台都有大量内联样式与可选的第三方统计脚本，
  # 严 CSP 会直接把站点搞坏，松 CSP 等于没有；要做就得先给内联样式发 nonce。
  # X-Frame-Options 用 SAMEORIGIN 而不是 DENY：后台会把同源的 waline /ui 放进 iframe。
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
    -Server
  }
  encode zstd gzip
	log {
		output file /var/log/vanblog-access.log
		format json
	}
  tls {
    on_demand
  }

  handle /ui* {
    reverse_proxy 127.0.0.1:8360 {
      import h
    }
  }
  handle /user* {
    reverse_proxy 127.0.0.1:8360 {
      import h
    }
  }
  handle /token* {
    reverse_proxy 127.0.0.1:8360 {
      import h
    }
  }
  handle /db* {
    reverse_proxy 127.0.0.1:8360 {
      import h
    }
  }
  handle /comment* {
    reverse_proxy 127.0.0.1:8360 {
      import h
    }
  }
  handle /oauth* {
    reverse_proxy 127.0.0.1:8360 {
      import h
    }
  }
	handle /favicon* {
    uri replace /favicon /static/img/favicon
		reverse_proxy 127.0.0.1:3000
	}
	handle /static/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /c/* {
		reverse_proxy 127.0.0.1:3000
	}
  handle /custom/* {
		reverse_proxy 127.0.0.1:3000
	}
  handle /feed.json {
    uri replace /feed.json /rss/feed.json
    reverse_proxy 127.0.0.1:3000
  }
  handle /feed.xml {
    uri replace /feed.xml /rss/feed.xml
    reverse_proxy 127.0.0.1:3000
  }
  handle /sitemap.xml {
    uri replace /sitemap.xml /sitemap/sitemap.xml
    reverse_proxy 127.0.0.1:3000
  }
  handle /atom.xml {
    uri replace /feed.xml /rss/atom.xml
    reverse_proxy 127.0.0.1:3000
  }
	handle /rss/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /swagger* {
		reverse_proxy 127.0.0.1:3000
	}
  handle /api/comment {
    uri strip_prefix /api
		reverse_proxy 127.0.0.1:8360 {
      import h
    }
	}
	handle /api/admin* {
    header Cache-Control "private, no-store, no-cache, must-revalidate"
    header CDN-Cache-Control "no-store"
    header Cloudflare-CDN-Cache-Control "no-store"
    header Pragma "no-cache"
    header Expires "0"
		reverse_proxy 127.0.0.1:3000
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle_path /admin* {
    header Cache-Control "private, no-store, no-cache, must-revalidate"
    header CDN-Cache-Control "no-store"
    header Cloudflare-CDN-Cache-Control "no-store"
    header Pragma "no-cache"
    header Expires "0"
		root * /app/admin
		try_files {path} /index.html
		file_server
	}
	reverse_proxy 127.0.0.1:3001
}

http:// {
  import van
}
https:// {
  import van
}
