{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/init-restore.e2e-spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "^(?!.*(@mdit|katex|hast-util|hastscript|parse5|property-information|space-separated-tokens|comma-separated-tokens|stringify-entities|character-entities|html-void-elements|ccount|zwitch|vfile|unist-util|web-namespaces|is-buffer)).*node_modules.*$"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  }
}
